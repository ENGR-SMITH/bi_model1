{
  "name": "@workspace/desktop-agent",
  "version": "0.0.1",
  "private": true,
  "description": "Tandem desktop agent — generate proxies with FFmpeg and push them to Cloudflare R2 via presigned URLs.",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile": "tsc -p tsconfig.json && node -e \"const fs=require('fs');['index','bubble'].forEach(n=>fs.copyFileSync('src/renderer/'+n+'.html','dist/renderer/'+n+'.html'));\"",
    "build": "pnpm run compile && electron-builder --publish never",
    "build:dir": "pnpm run compile && electron-builder --dir --publish never",
    "dev": "pnpm run compile && electron .",
    "start": "electron ."
  },
  "author": "Tandem",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "~5.9.3",
    "@types/node": "catalog:"
  },
  "build": {
    "appId": "com.tandem.desktopagent",
    "productName": "Tandem Desktop Agent",
    "directories": { "output": "dist-bundle" },
    "files": ["dist/**/*"],
    "compression": "normal",
    "publish": [{ "provider": "generic", "url": "https://{{HOST}}/desktop-agent" }],
    "protocols": [
      {
        "name": "Tandem Desktop Agent",
        "schemes": ["tandem-agent"]
      }
    ],
    "extraResources": [
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": ["ffmpeg*"]
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.video"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": { "target": ["AppImage"] }
  }
}