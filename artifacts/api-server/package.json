{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "workers": "node --enable-source-maps ./dist/workers/all.mjs",
    "worker:proxy": "node --enable-source-maps ./dist/workers/proxy-worker.mjs",
    "worker:transcribe": "node --enable-source-maps ./dist/workers/transcribe-worker.mjs",
    "worker:sync": "node --enable-source-maps ./dist/workers/sync-worker.mjs",
    "worker:render": "node --enable-source-maps ./dist/workers/render-worker.mjs",
    "worker:audio": "node --enable-source-maps ./dist/workers/audio-worker.mjs",
    "worker:finish": "node --enable-source-maps ./dist/workers/finish-worker.mjs",
    "worker:reference": "node --enable-source-maps ./dist/workers/reference-worker.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.55",
    "@clerk/shared": "^4.28.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bullmq": "^5.81.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^5.11.1",
    "multer": "^2.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "sql.js": "^1.13.0",
    "supertest": "^7.1.1",
    "thread-stream": "3.1.0",
    "vitest": "^3.2.4"
  }
}
