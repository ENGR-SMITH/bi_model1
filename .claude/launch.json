{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "creators-den-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "artifacts/creators-den/node_modules/vite/bin/vite.js",
        "--config",
        "artifacts/creators-den/vite.config.ts",
        "--host",
        "0.0.0.0"
      ],
      "env": {
        "CREATORS_DEV_NO_AUTH": "1",
        "PORT": "5180",
        "BASE_PATH": "/creators-den/"
      },
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "creators-den-auth",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "artifacts/creators-den/node_modules/vite/bin/vite.js",
        "--config",
        "artifacts/creators-den/vite.config.ts",
        "--host",
        "0.0.0.0"
      ],
      "env": {
        "PORT": "5181",
        "BASE_PATH": "/creators-den/"
      },
      "port": 5181,
      "autoPort": false
    },
    {
      "name": "tandem-signin",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "artifacts/tandem/node_modules/vite/bin/vite.js",
        "--config",
        "artifacts/tandem/vite.config.ts",
        "--host",
        "0.0.0.0"
      ],
      "env": {
        "PORT": "5176",
        "BASE_PATH": "/"
      },
      "port": 5176,
      "autoPort": false
