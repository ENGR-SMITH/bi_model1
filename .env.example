# ---------------------------------------------------------------------------
# Nexet / Author Den environment configuration
# Copy this file to `.env` (in the repo root or in artifacts/api-server) and
# fill in your values. The API server loads `.env` automatically on boot when
# present; variables you export in the shell take precedence over the file.
# ---------------------------------------------------------------------------

# ---- Ports & server --------------------------------------------------------
# Port the API server listens on.
PORT=3000

# ---- Database ---------------------------------------------------------------
# PostgreSQL connection string used by the Drizzle schema.
# Copy your real connection string into .env (this file is committed to the
# repo, so it must never contain a live credential).
# postgresql://postgres:Engrsmith123@localhost:5432/tandem
DATABASE_URL=
# ---- Cloudflare R2 object storage --------------------------------------------
# Proxies, renders/exports, and interchange bundles are stored in R2 instead of
# local disk. The server only mints short-lived presigned URLs — the browser /
# desktop agent PUTs and GETs the bytes straight to Cloudflare ($0 egress).
# When these four are unset, artifacts fall back to local disk (local dev/tests).
# Get them from dash.cloudflare.com → R2 → (account id, bucket, API token).
CF_ACCOUNT_ID=
CF_R2_BUCKET=tandem-media
CF_R2_ACCESS_KEY=
CF_R2_SECRET_KEY=

# Public download URL for the packaged desktop agent (shown as a "Desktop agent
# for large files" button in the Creator Den vault and the Nexet doorway).
# Copied into each Vite app's .env as VITE_AGENT_DOWNLOAD_URL.
# e.g. https://pub-<hash>.r2.dev/desktop-agent/nexet-desktop-agent-latest.exe
VITE_AGENT_DOWNLOAD_URL=

# Public origin of the Nexet web app (creators-den), no trailing slash. The
# desktop agent's "Sign up" link points at its hosted /agent-signin page —
# Clerk only initialises sign-in on origins registered for the instance, so
# the page runs on the web app's domain, not on a loopback server.
# Read by the desktop agent (NEXET_WEB_URL); default is http://localhost:5175
# for local dev. Production installs must set this to the deployed web app.
# e.g. NEXET_WEB_URL=https://app.nexet.com
NEXET_WEB_URL=

# ---- Creator Den · YouTube OAuth (channel linking) --------------------------
# Google OAuth 2.0 Client ID + Secret of type *Web application* (Google Cloud
# Console → APIs & Services → Credentials) with the YouTube Data API v3 and
# YouTube Analytics API enabled on the project. Without these, the channel
# connect flow reports "not configured".
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Authorized redirect URI registered on that OAuth client (exact match
# required — also add the app origin to "Authorized JavaScript origins").
# Defaults to ${NEXET_WEB_URL}/creators-den/channels/oauth/callback when
# unset; local dev is http://localhost:5175/creators-den/channels/oauth/callback
YOUTUBE_REDIRECT_URI=

# ---- Creator Den · YouTube Analytics sync (Phase 3) -------------------------
# Optional YouTube Data API v3 key (an "API key" credential, not OAuth). Used
# as a fallback for public stats; analytics still requires the OAuth link
# above to be configured.
YOUTUBE_DATA_API_KEY=
# Cadence of the background analytics refresh loop (minutes). Default 60.
YT_SYNC_INTERVAL_MINUTES=60
# Freshness window for the on-demand report caches — retention, traffic,
# demographics, devices, revenue (minutes). Default 360.
YT_REPORT_TTL_MINUTES=360
# Metric snapshot horizon: how many days back daily channel/video metrics are
# backfilled and kept. Default 90.
YT_ANALYTICS_DAYS=90
# Per-sync cap on per-video report queries (YouTube quota guard). Default 100.
YT_SYNC_MAX_VIDEO_QUERIES=100

# Loopback port of the desktop agent's control server (the channel Creator Den
# uses to detect a running agent, launch it with the project + return URL, and
# watch the upload job so it can redirect the user back). Must match between
# the web app (VITE_AGENT_CONTROL_PORT) and the agent (NEXET_AGENT_CONTROL_PORT).
# Default 41737. The agent also registers the nexet-agent:// deep link (built
# into the installer) so Creator Den can launch an installed-but-idle agent.
VITE_AGENT_CONTROL_PORT=41737
NEXET_AGENT_CONTROL_PORT=41737

# ---- Desktop agent (optional overrides) --------------------------------------
# The desktop agent (artifacts/desktop-agent) reads these env vars; without
# them it uses its built-in defaults (see src/main/config.ts) or a config
# file (nexet-agent.json / ~/.nexet-agent/config.json). Only set the ones you
# need to override.
# Base URL of the Nexet API server, no trailing slash.
# Default http://localhost:3000; production should point at the deployed API.
# e.g. NEXET_API_URL=https://api.nexet.com
NEXET_API_URL=
# Clerk publishable key for the browser sign-in page. Public by design — the
# web apps embed the same one. If unset, the agent ships with the shared Nexet
# Clerk instance key as its built-in default.
NEXET_CLERK_PUBLISHABLE_KEY=
# Path to the ffmpeg binary. When blank, the agent looks on PATH.
NEXET_FFMPEG_PATH=
# Local temp dir for staging proxies before upload. Default ~/.nexet-agent/work
NEXET_AGENT_WORK_DIR=
# Auto-update feed base URL (where latest.yml / latest-mac.yml live), no
# trailing slash. Defaults to <NEXET_API_URL>/desktop-agent when unset.
NEXET_UPDATE_URL=

# ---- Redis (BullMQ video job queue) ------------------------------------------
# Optional — set to enable BullMQ mode for the video job queue (proxies,
# transcodes, renders, exports). Without it the API falls back to the
# in-process polling loop (fine for small loads; keep the server at 1 instance).
# With it, jobs are claimed by Redis and you can run a separate worker fleet:
# `pnpm --filter @workspace/api-server run workers`.
# e.g. REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# ---- Storage lifecycle (Creator Den) ----------------------------------------
# Days an uploaded original is kept on the ephemeral processing disk after its
# proxy is ready and a durable R2 copy exists. The R2 copy is always kept;
# this only reclaims the local cache. Default 30 (playbook: raw files deleted
# 30 days after the project completes); 0 disables local retention.
ORIGINAL_RETENTION_DAYS=30
# Cadence of the nightly storage metering + retention sweeps (hours). These
# run in the API server process on startup.
STORAGE_METER_INTERVAL_HOURS=24
STORAGE_RETENTION_INTERVAL_HOURS=24

# ---- Authentication (Clerk) -------------------------------------------------
# Publishable + secret keys from your Clerk instance.
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
# The Oracle Admin app (artifacts/oracle-admin) reads CLERK_PUBLISHABLE_KEY
# directly from this root .env at build/dev time — it needs no per-app .env.
# The other three Vite apps (Nexet, Author Den, Creator Den) still copy it
# into their own .env as VITE_CLERK_PUBLISHABLE_KEY.

# ---- Whop (subscription payments, USD) ---------------------------------------
# How to get these (one-time setup):
#   1. Create your Whop account + business at https://whop.com/start (complete
#      activation/KYC — required before you can take live payments or pay out).
#   2. WHOP_API_KEY  — Developer dashboard (whop.com/dashboard → Developer →
#      Account API Keys) → Create → name it e.g. "Nexet production" → copy the
#      key (whop_…). Server-only: never put it in any frontend .env. Start with
#      the Admin role, then narrow to the exact permissions the app needs.
#   3. WHOP_ACCOUNT_ID — Dashboard → Settings → your Account ID (biz_…). The
#      API needs it to create plans and open checkouts.
#   4. WHOP_PRODUCT_ID — Dashboard → Products → create one product (prod_…);
#      every subscription plan is mirrored under it. The product title shows on
#      the Whop checkout page.
#   5. WHOP_WEBHOOK_SECRET — Dashboard → Developer → Webhooks → Create webhook:
#      URL https://<your-api-host>/api/whop/webhook, subscribe to payment.* and
#      membership.* events → copy the signing secret (ws_…). It is shown ONLY
#      ONCE at creation — store it immediately. Whop signs every webhook with
#      HMAC-SHA256 over the raw body (Standard Webhooks spec); there is no
#      other secret.
# Sandbox: Whop has a separate sandbox environment (sandbox.whop.com) with its
# own keys — use them for development so no real money moves, then swap in the
# live keys for production.
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_PRODUCT_ID=
WHOP_WEBHOOK_SECRET=

# ---- CORS (API server, production only) -------------------------------------
# Comma-separated origins allowed to call the API with credentials in
# production (e.g. https://app.yourdomain.com,https://authors.yourdomain.com).
# The API server refuses to boot in production without this. Ignored in dev,
# where any origin is reflected so localhost ports / tunnels / Vite proxies
# keep working.
CORS_ORIGINS=

# ---- Story Oracle admin -----------------------------------------------------
# The email that may open the private Oracle Admin page (/oracle-admin).
# Sign-in is a Clerk magic link: type this email into the admin page, Clerk
# emails you a link, click it, and you're in — no password to create,
# remember, or lose. The API server refuses to boot in production without this.
# e.g. ADMIN_EMAIL=you@yourdomain.com
ADMIN_EMAIL=

# Secret used to encrypt stored provider API keys. Must stay stable across
# restarts or stored keys become unreadable. Dev fallback only — production
# refuses to boot with this default.
SESSION_SECRET=manuskript-development-key

# ---- Model provider credentials ----------------------------------------------
# These are read at boot and seeded into the admin page's provider list when
# the provider has no key configured yet. A key saved from the admin page
# overrides the environment value. Keys are stored encrypted in the database.
# Groq (hosted, fast)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_ID=llama-3.3-70b-versatile

# OpenRouter (hosted, multi-model)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_ID=openrouter/free

# Ollama (local, no API key required)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_ID=llama3.2

# LM Studio (local, no API key required)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL_ID=local-model
# Freebuff model gateway (optional — API key can also be entered in the Oracle admin page)
FREEBUFF_API_KEY=
FREEBUFF_BASE_URL=http://localhost:8081/v1
FREEBUFF_MODEL_ID=deepseek-v4-flash

# ---- Logging -----------------------------------------------------------------
LOG_LEVEL=info

# =============================================================================
# ⚠️ NEXET REBRAND — ENV VAR NAME CHANGES (Tandem → Nexet)
# =============================================================================
# When the app was renamed from TANDEM to NEXET, the env var names below
# changed. In your PRODUCTION deployment (Render dashboard, server, etc.) you
# must RENAME these variables — the VALUES stay exactly the same.
#
#   OLD NAME (Tandem)              NEW NAME (Nexet)
#   -----------------------------  ---------------------------------
#   TANDEM_WEB_URL                 NEXET_WEB_URL
#   TANDEM_AGENT_CONTROL_PORT      NEXET_AGENT_CONTROL_PORT
#   TANDEM_MEDIA_DEMO              NEXET_MEDIA_DEMO            (test-only)
#   TANDEM_API_URL                 NEXET_API_URL               (desktop agent)
#   TANDEM_CLERK_PUBLISHABLE_KEY   NEXET_CLERK_PUBLISHABLE_KEY (desktop agent)
#   TANDEM_FFMPEG_PATH             NEXET_FFMPEG_PATH           (desktop agent)
#   TANDEM_AGENT_WORK_DIR          NEXET_AGENT_WORK_DIR        (desktop agent)
#   TANDEM_UPDATE_URL              NEXET_UPDATE_URL            (desktop agent)
#
# DO NOT rename (keep current names + values):
#   DATABASE_URL, CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY,
#   WHOP_API_KEY, WHOP_ACCOUNT_ID, WHOP_PRODUCT_ID, WHOP_WEBHOOK_SECRET,
#   YOUTUBE_OAUTH_CLIENT_ID,
#   YOUTUBE_OAUTH_CLIENT_SECRET, CF_ACCOUNT_ID, CF_R2_BUCKET (=tandem-media),
#   CF_R2_ACCESS_KEY, CF_R2_SECRET_KEY, VITE_AGENT_CONTROL_PORT,
#   VITE_AGENT_DOWNLOAD_URL
#
# Desktop agent config files also moved: tandem-agent.json → nexet-agent.json
# and ~/.tandem-agent/config.json → ~/.nexet-agent/config.json (same values
# inside). Existing agent installs must be reinstalled (protocol + appId
# changed: tandem-agent:// → nexet-agent://, com.tandem.desktopagent →
# com.nexet.desktopagent).
# =============================================================================

# =============================================================================
# ✅ PRODUCTION DEPLOYMENT — THE MAIN NECESSARY VARIABLES (Render, live users)
# =============================================================================
# Your local .env is NOT used by the deployed app — the Docker image strips all
# .env files. You must paste these values into the Render dashboard yourself.
#
# The app refuses to boot (fails closed) without these:
#
#   NODE_ENV                      = production
#   PORT                          = (Render sets this itself — do not override)
#   DATABASE_URL                  = your Supabase Postgres connection string
#   CORS_ORIGINS                  = https://app.YOURDOMAIN.com,https://authors.YOURDOMAIN.com
#   ADMIN_EMAIL                   = the email that opens Oracle Admin (Clerk magic link)
#   SESSION_SECRET                = a strong, random, NON-default string (min ~32 chars)
#   CLERK_PUBLISHABLE_KEY         = your real Clerk publishable key (pk_…)
#   CLERK_SECRET_KEY              = your real Clerk secret key (sk_…)
#   VITE_CLERK_PUBLISHABLE_KEY    = same Clerk publishable key (REQUIRED build arg)
#   NEXET_WEB_URL                 = https://app.YOURDOMAIN.com  (your real domain, no trailing slash)
#
# Feature-critical (needed once the related feature is live):
#
#   WHOP_API_KEY + WHOP_ACCOUNT_ID + WHOP_PRODUCT_ID + WHOP_WEBHOOK_SECRET
#                                 = payments — checkout returns 503 without them
#   REDIS_URL                     = your Upstash URL — enables the BullMQ worker fleet
#   NEXET_AGENT_CONTROL_PORT      = 41737 (must match VITE_AGENT_CONTROL_PORT)
#
# Recommended so uploads/proxies/renders don't fall back to the ephemeral
# container disk (add a Render Disk and point VIDEO_UPLOAD_DIR at it):
#
#   CF_ACCOUNT_ID                 = Cloudflare account id
#   CF_R2_BUCKET                  = tandem-media (your existing bucket)
#   CF_R2_ACCESS_KEY              = Cloudflare R2 access key
#   CF_R2_SECRET_KEY              = Cloudflare R2 secret key
#   VIDEO_UPLOAD_DIR              = /var/data/uploads (mounted Render Disk)
#
# Optional feature toggles (the app runs fine without them):
#
#   YOUTUBE_OAUTH_CLIENT_ID / _SECRET  = Creator Den channel linking
#   YOUTUBE_REDIRECT_URI               = defaults to ${NEXET_WEB_URL}/creators-den/channels/oauth/callback
#   YOUTUBE_DATA_API_KEY               = public stats fallback
#   YT_SYNC_INTERVAL_MINUTES           = 60 · YT_REPORT_TTL_MINUTES = 360
#   YT_ANALYTICS_DAYS                  = 90 · YT_SYNC_MAX_VIDEO_QUERIES = 100
#   ORIGINAL_RETENTION_DAYS            = 30
#   STORAGE_METER_INTERVAL_HOURS       = 24 · STORAGE_RETENTION_INTERVAL_HOURS = 24
#   VITE_AGENT_DOWNLOAD_URL            = desktop agent download link (button only)
#   GROQ_* / OPENROUTER_* / OLLAMA_* / LMSTUDIO_* / FREEBUFF_*  = Story Oracle AI
#   LOG_LEVEL                         = info
#
# NOT read by the web app — safe to skip on Render:
#   ADMIN_ACCESS_CODE (legacy, replaced by ADMIN_EMAIL magic link) ·
#   ANON_PUBLIC + SERVICE_ROLE (Supabase dashboard keys — the app connects via
#   DATABASE_URL instead).
#
# Desktop-agent-only (run on USERS' computers, not the Render server):
#   NEXET_CLERK_PUBLISHABLE_KEY · NEXET_API_URL · NEXET_FFMPEG_PATH ·
#   NEXET_AGENT_WORK_DIR · NEXET_UPDATE_URL · NEXET_AGENT_CONTROL_PORT ·
#   NEXET_MEDIA_DEMO (test-only)
# =============================================================================
